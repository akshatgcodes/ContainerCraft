# Required for the REST API's write endpoints (start/stop/restart) and, once set, for all
# endpoints. Without it the API is read-only. Any long random string.
CRAFT_API_KEY=

# Run the health monitor inside the API process
CRAFT_MONITOR=false
CRAFT_CPU_THRESHOLD=80
CRAFT_MEM_THRESHOLD=90
CRAFT_INTERVAL=30
# true = restart containers that stay over threshold; false = warn only
CRAFT_AUTO_RESTART=false
